package components

templ Icon(name string, classes string) {
	switch name {
	case "activity":
		<svg xmlns="http://www.w3.org/2000/svg" class={ classes } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="m22 12-4-4-6 6-4-4-4 4"/>
			<path d="M8 21h8"/>
		</svg>
	case "dumbbell":
		<svg xmlns="http://www.w3.org/2000/svg" class={ classes } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="m6.5 6.5 11 11"/>
			<path d="m21 21-1-1"/>
			<path d="m3 3 1 1"/>
			<path d="m18 22 4-4"/>
			<path d="m2 6 4-4"/>
			<path d="m3 10 7-7"/>
			<path d="m14 21 7-7"/>
		</svg>
	case "footprints":
		<svg xmlns="http://www.w3.org/2000/svg" class={ classes } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M4 16v-2.38C4 11.5 2.97 10.5 3 8c.03-2.72 1.49-6 4.5-6C9.37 2 10 3.8 10 5.5c0 3.11-2 5.66-2 8.68V16a2 2 0 1 1-4 0Z"/>
			<path d="M20 20v-2.38c0-2.12 1.03-3.12 1-5.62-.03-2.72-1.49-6-4.5-6C14.63 6 14 7.8 14 9.5c0 3.11 2 5.66 2 8.68V20a2 2 0 1 0 4 0Z"/>
			<path d="M16 17h4"/>
			<path d="M4 13h4"/>
		</svg>
	case "heart":
		<svg xmlns="http://www.w3.org/2000/svg" class={ classes } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z"/>
		</svg>
	case "droplets":
		<svg xmlns="http://www.w3.org/2000/svg" class={ classes } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M7 16.3c2.2 0 4-1.83 4-4.05 0-1.16-.57-2.26-1.71-3.19S7.29 6.75 7 5.3c-.29 1.45-1.14 2.84-2.29 3.76S3 11.1 3 12.25c0 2.22 1.8 4.05 4 4.05z"/>
			<path d="M12.56 6.6A10.97 10.97 0 0 0 14 3.02c.5 2.5 2.04 4.6 4.14 5.93c2.1 1.33 3.14 2.87 3.14 4.55c0 1.94-1.1 3.94-2.76 5.37"/>
			<path d="M12.56 6.6A10.97 10.97 0 0 1 10 3.02c-.5 2.5-2.04 4.6-4.14 5.93C3.76 10.28 2.72 11.82 2.72 13.5c0 1.94 1.1 3.94 2.76 5.37"/>
		</svg>
	case "moon":
		<svg xmlns="http://www.w3.org/2000/svg" class={ classes } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
		</svg>
	case "sun":
		<svg xmlns="http://www.w3.org/2000/svg" class={ classes } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<circle cx="12" cy="12" r="4"/>
			<path d="M12 2v2"/>
			<path d="M12 20v2"/>
			<path d="m4.93 4.93 1.41 1.41"/>
			<path d="m17.66 17.66 1.41 1.41"/>
			<path d="M2 12h2"/>
			<path d="M20 12h2"/>
			<path d="m6.34 17.66-1.41 1.41"/>
			<path d="m19.07 4.93-1.41 1.41"/>
		</svg>
	case "star":
		<svg xmlns="http://www.w3.org/2000/svg" class={ classes } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/>
		</svg>
	case "book-open":
		<svg xmlns="http://www.w3.org/2000/svg" class={ classes } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
			<path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
		</svg>
	case "utensils":
		<svg xmlns="http://www.w3.org/2000/svg" class={ classes } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/>
			<path d="M7 2v20"/>
			<path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>
		</svg>
	case "scale":
		<svg xmlns="http://www.w3.org/2000/svg" class={ classes } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M16 4h3a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1h-3"/>
			<path d="M8 4H5a1 1 0 0 0-1 1v4a1 1 0 0 0 1 1h3"/>
			<path d="M12 4v16"/>
			<path d="M8 15h8"/>
			<path d="m6 19 6-2 6 2"/>
		</svg>
	case "trophy":
		<svg xmlns="http://www.w3.org/2000/svg" class={ classes } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/>
			<path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/>
			<path d="M4 22h16"/>
			<path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/>
			<path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/>
			<path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>
		</svg>
	case "target":
		<svg xmlns="http://www.w3.org/2000/svg" class={ classes } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<circle cx="12" cy="12" r="10"/>
			<circle cx="12" cy="12" r="6"/>
			<circle cx="12" cy="12" r="2"/>
		</svg>
	case "zap":
		<svg xmlns="http://www.w3.org/2000/svg" class={ classes } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<polygon points="13,2 3,14 12,14 11,22 21,10 12,10"/>
		</svg>
	case "coffee":
		<svg xmlns="http://www.w3.org/2000/svg" class={ classes } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M18 8h1a4 4 0 0 1 0 8h-1"/>
			<path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8Z"/>
			<line x1="6" x2="6" y1="1" y2="4"/>
			<line x1="10" x2="10" y1="1" y2="4"/>
			<line x1="14" x2="14" y1="1" y2="4"/>
		</svg>
	case "apple":
		<svg xmlns="http://www.w3.org/2000/svg" class={ classes } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M12 20.94c1.5 0 2.75 1.06 4 1.06 3 0 6-8 6-12.22A4.91 4.91 0 0 0 17 5c-2.22 0-4 1.44-5 2-1-.56-2.78-2-5-2a4.9 4.9 0 0 0-5 4.78C2 14 5 22 8 22c1.25 0 2.5-1.06 4-1.06Z"/>
			<path d="M10 2c1 .5 2 2 2 5"/>
		</svg>
	case "chart-bar":
		<svg xmlns="http://www.w3.org/2000/svg" class={ classes } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<line x1="12" x2="12" y1="20" y2="10"/>
			<line x1="18" x2="18" y1="20" y2="4"/>
			<line x1="6" x2="6" y1="20" y2="16"/>
		</svg>
	case "edit":
		<svg xmlns="http://www.w3.org/2000/svg" class={ classes } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
			<path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4Z"/>
		</svg>
	case "trash":
		<svg xmlns="http://www.w3.org/2000/svg" class={ classes } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M3 6h18"/>
			<path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
			<path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
		</svg>
	default:
		<svg xmlns="http://www.w3.org/2000/svg" class={ classes } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<line x1="12" x2="12" y1="20" y2="10"/>
			<line x1="18" x2="18" y1="20" y2="4"/>
			<line x1="6" x2="6" y1="20" y2="16"/>
		</svg>
	}
}