package components

import (
	"fmt"
	"health-monitor/internal/db"
)

templ GaugeTemplateList(gaugeTemplates []db.GaugeTemplate) {
	<div id="gauge-template-list" class="p-6">
		<div class="flex justify-between items-center mb-6">
			<h1 class="text-2xl font-bold">Gauge Templates</h1>
			<a href="/admin/gauges/new" class="btn btn-primary gap-2">
				<span>+</span>
				<span>New Gauge</span>
			</a>
		</div>

		<div class="overflow-x-auto bg-base-100 shadow-xl rounded-box">
			<table class="table table-zebra">
				<thead>
					<tr>
						<th>Icon</th>
						<th>Name</th>
						<th>Description</th>
						<th>Frequency</th>
						<th>Direction</th>
						<th>Target</th>
						<th>Active</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					for _, template := range gaugeTemplates {
						<tr class="hover">
							<td>
								<div class="p-2 bg-primary/10 rounded-lg w-fit">
									@Icon(template.Icon, "w-6 h-6 text-primary")
								</div>
							</td>
							<td class="font-medium">{ template.Name }</td>
							<td class="max-w-xs truncate">
								if template.Description.Valid {
									{ template.Description.String }
								} else {
									<span class="text-base-content/50">No description</span>
								}
							</td>
							<td>
								<span class="badge badge-outline">
									{ template.Frequency }
								</span>
							</td>
							<td>
								if template.Direction == "under" {
									<span class="flex items-center gap-1">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
										</svg>
										Under
									</span>
								} else {
									<span class="flex items-center gap-1">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
										</svg>
										Over
									</span>
								}
							</td>
							<td>{ fmt.Sprintf("%d %s", template.Target, template.Unit) }</td>
							<td>
								if template.Active {
									<span class="badge badge-success">Active</span>
								} else {
									<span class="badge badge-ghost">Inactive</span>
								}
							</td>
							<td>
								<div class="flex gap-2">
									<a href={ templ.URL(fmt.Sprintf("/admin/gauges/%d", template.ID)) } class="btn btn-square btn-sm btn-ghost">
										@Icon("edit", "w-4 h-4")
									</a>
									<button
										class="btn btn-square btn-sm btn-ghost text-error hover:bg-error hover:text-base-100"
										hx-delete={ fmt.Sprintf("/admin/gauges/%d", template.ID) }
										hx-target="#gauge-template-list"
										hx-swap="outerHTML"
										hx-confirm="Are you sure you want to delete this gauge template? This will also delete all associated instances."
									>
										@Icon("trash", "w-4 h-4")
									</button>
								</div>
							</td>
						</tr>
					}
					if len(gaugeTemplates) == 0 {
						<tr>
							<td colspan="8" class="text-center py-8 text-base-content/50">
								No gauge templates found. <a href="/admin/gauges/new" class="link link-primary">Create your first gauge</a>.
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}