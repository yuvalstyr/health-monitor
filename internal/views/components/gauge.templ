package components

import (
	"fmt"
	"health-monitor/internal/db"
)

func min(a, b int) int {
	if a < b {
		return a
	}
	return b
}

func getGaugeStatus(value, target int64, direction string) string {
	if direction == "under" {
		if value <= target {
			return "success" // Green - meeting target
		}
		return "error" // Red - over target
	} else { // direction == "over" 
		if value >= target {
			return "success" // Green - meeting target
		}
		return "error" // Red - under target
	}
}

func getProgressPercentage(value, target int64) float64 {
	if target == 0 {
		return 0
	}
	
	percentage := (float64(value) / float64(target)) * 100
	if percentage > 100 {
		return 100
	}
	return percentage
}

templ GaugeValue(gaugeInstance *db.GaugeInstance) {
	<div id={ fmt.Sprintf("gauge-instance-value-%d", gaugeInstance.ID) } class="space-y-2 sm:space-y-3">
			<!-- Gauge value -->
			<div class="flex justify-between items-baseline mt-2">
				<div class="text-4xl font-bold">
					{ fmt.Sprintf("%d", gaugeInstance.Value) }
				</div>
			</div>
	</div>
}

templ GaugeCard(gaugeInstance *db.GaugeInstance, template *db.GaugeTemplate) {
	if getGaugeStatus(gaugeInstance.Value, template.Target, template.Direction) == "success" {
		<div id={ fmt.Sprintf("gauge-card-%d", gaugeInstance.ID) } class="card bg-base-100 shadow-lg hover:shadow-xl transition-all border-l-4 border-l-green-500">
			@gaugeCardContent(gaugeInstance, template)
		</div>
	} else {
		<div id={ fmt.Sprintf("gauge-card-%d", gaugeInstance.ID) } class="card bg-base-100 shadow-lg hover:shadow-xl transition-all border-l-4 border-l-red-500">
			@gaugeCardContent(gaugeInstance, template)
		</div>
	}
}

templ gaugeCardContent(gaugeInstance *db.GaugeInstance, template *db.GaugeTemplate) {
	<div class="card-body p-2 sm:p-4 relative flex flex-col">
		<!-- Mobile-first compact layout -->
		<div class="sm:hidden space-y-1">
			<!-- Ultra compact horizontal layout for mobile -->
			<div class="flex items-center justify-between gap-2">
				<!-- Icon + Name + Value in one row -->
				<div class="flex items-center gap-2 flex-1 min-w-0">
					<div class="flex-shrink-0">
						@Icon(template.Icon, "w-5 h-5 text-primary")
					</div>
					<div class="flex-1 min-w-0">
						<div class="text-xs font-semibold truncate">{ template.Name }</div>
						<div class="text-[0.5rem] leading-[0.75rem] text-base-content/60">{ template.Frequency }</div>
					</div>
					<div id={ fmt.Sprintf("gauge-value-container-%d", gaugeInstance.ID) } class="flex-shrink-0">
						@GaugeInstanceValue(gaugeInstance)
					</div>
				</div>
				<!-- Touch-friendly buttons -->
				<div class="flex gap-2 flex-shrink-0">
					<button 
						class="btn btn-circle btn-sm bg-error text-white hover:bg-error/80 shadow-sm"
						style="min-width: 36px; min-height: 36px;"
						hx-post={ fmt.Sprintf("/gauges/%d/decrement", gaugeInstance.ID) }
						hx-target={ fmt.Sprintf("#gauge-instance-value-%d", gaugeInstance.ID) }
						hx-swap="outerHTML"
					>
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" /></svg>
					</button>
					<button 
						class="btn btn-circle btn-sm bg-success text-white hover:bg-success/80 shadow-sm"
						style="min-width: 36px; min-height: 36px;"
						hx-post={ fmt.Sprintf("/gauges/%d/increment", gaugeInstance.ID) }
						hx-target={ fmt.Sprintf("#gauge-instance-value-%d", gaugeInstance.ID) }
						hx-swap="outerHTML"
					>
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" /></svg>
					</button>
				</div>
			</div>
			<!-- Progress bar in second row -->
			<div class="w-full bg-base-300 rounded-full h-1">
				if getGaugeStatus(gaugeInstance.Value, template.Target, template.Direction) == "success" {
					<div class="h-1 rounded-full transition-all duration-300 bg-green-500" style={ fmt.Sprintf("width: %.1f%%", getProgressPercentage(gaugeInstance.Value, template.Target)) }></div>
				} else {
					<div class="h-1 rounded-full transition-all duration-300 bg-red-500" style={ fmt.Sprintf("width: %.1f%%", getProgressPercentage(gaugeInstance.Value, template.Target)) }></div>
				}
			</div>
		</div>

		<!-- Desktop layout (hidden on mobile) -->
		<div class="hidden sm:block">
			<!-- Action buttons in top right corner -->
			<div class="absolute top-2 right-2 flex gap-1">
				<a href={ templ.URL(fmt.Sprintf("/trends/%d", template.ID)) } class="btn btn-circle btn-sm btn-ghost" title="View Trends">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 712-2h2a2 2 0 712 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 712-2h2a2 2 0 712 2v14a2 2 0 71-2 2h-2a2 2 0 71-2-2z" /></svg>
				</a>
				<a href={ templ.URL(fmt.Sprintf("/admin/gauges/%d", template.ID)) } class="btn btn-circle btn-sm btn-ghost" title="Edit Gauge">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
				</a>
			</div>
			
			<!-- Compact header with larger icon and name -->
			<div class="flex items-center gap-3 mt-2">
				<div class="p-3 rounded-lg bg-primary/10">
					@Icon(template.Icon, "w-8 h-8 text-primary")
				</div>
				<div class="flex-grow">
					<h2 class="text-xl font-bold leading-tight mb-0">{ template.Name }</h2>
					<div class="text-sm text-base-content/70">
						{ template.Frequency } 
						if template.Direction == "under" {
							<span>↓</span>
						} else {
							<span>↑</span>
						}
					</div>
				</div>
			</div>
			
			<!-- Use GaugeInstanceValue component instead of direct rendering -->
			<div id={ fmt.Sprintf("gauge-value-container-%d", gaugeInstance.ID) } class="mt-2">
				@GaugeInstanceValue(gaugeInstance)
			</div>
			
			<!-- Progress bar showing percentage to target -->
			<div class="mt-3 mb-2">
				<div class="w-full bg-base-300 rounded-full h-2">
					if getGaugeStatus(gaugeInstance.Value, template.Target, template.Direction) == "success" {
						<div class="h-2 rounded-full transition-all duration-300 bg-green-500" style={ fmt.Sprintf("width: %.1f%%", getProgressPercentage(gaugeInstance.Value, template.Target)) }></div>
					} else {
						<div class="h-2 rounded-full transition-all duration-300 bg-red-500" style={ fmt.Sprintf("width: %.1f%%", getProgressPercentage(gaugeInstance.Value, template.Target)) }></div>
					}
				</div>
				<div class="text-xs text-center mt-1 text-base-content/70">
					{ fmt.Sprintf("%.0f%% to target", getProgressPercentage(gaugeInstance.Value, template.Target)) }
				</div>
			</div>
			
			<!-- Larger increment/decrement buttons, vertically centered -->
			<div class="flex justify-center gap-4 items-center flex-grow mt-2">
				<button 
					class="btn btn-circle btn-lg bg-error text-white shadow-md hover:bg-error/90 transition-colors"
					style="min-width: 56px; min-height: 56px;"
					hx-post={ fmt.Sprintf("/gauges/%d/decrement", gaugeInstance.ID) }
					hx-target={ fmt.Sprintf("#gauge-instance-value-%d", gaugeInstance.ID) }
					hx-swap="outerHTML"
				>
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" /></svg>
				</button>
				<button 
					class="btn btn-circle btn-lg bg-success text-white shadow-md hover:bg-success/90 transition-colors"
					style="min-width: 56px; min-height: 56px;"
					hx-post={ fmt.Sprintf("/gauges/%d/increment", gaugeInstance.ID) }
					hx-target={ fmt.Sprintf("#gauge-instance-value-%d", gaugeInstance.ID) }
					hx-swap="outerHTML"
				>
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" /></svg>
				</button>
			</div>
		</div>
	</div>
}

templ Gauge(gaugeInstance *db.GaugeInstance, template *db.GaugeTemplate) {
	<div id={ fmt.Sprintf("gauge-%d", gaugeInstance.ID) } class="p-4 bg-base-100 rounded-lg shadow">
		<div class="flex items-center gap-2">
			<div class="p-2 bg-primary/10 rounded-lg">
				@Icon(template.Icon, "w-6 h-6 text-primary")
			</div>
			<h2 class="text-lg font-bold">{ template.Name }</h2>
			<span class="badge badge-sm ml-auto">{ template.Frequency }</span>
			<span class="badge badge-sm">
				if template.Direction == "under" {
					<span>↓</span>
				} else {
					<span>↑</span>
				}
			</span>
		</div>
		
		<div class="my-3">
			@GaugeValue(gaugeInstance)
		</div>
		
		<div class="flex justify-center gap-2 mt-3">
			<button 
				class="btn btn-sm btn-success"
				hx-post={ fmt.Sprintf("/gauges/%d/increment", gaugeInstance.ID) }
				hx-target={ fmt.Sprintf("#gauge-%d", gaugeInstance.ID) }
				hx-swap="outerHTML"
			>+</button>
			<button 
				class="btn btn-sm btn-error"
				hx-post={ fmt.Sprintf("/gauges/%d/decrement", gaugeInstance.ID) }
				hx-target={ fmt.Sprintf("#gauge-%d", gaugeInstance.ID) }
				hx-swap="outerHTML"
			>-</button>
		</div>
	</div>
}