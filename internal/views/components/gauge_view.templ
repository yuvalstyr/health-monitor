package components

import (
	"fmt"
	"health-monitor/internal/db"
)

templ GaugeView(gaugeInstance *db.GaugeInstance, template *db.GaugeTemplate) {
	<div class="max-w-4xl mx-auto py-8">
		<div class="flex justify-between items-center mb-8">
			<div>
				<h1 class="text-4xl font-bold mb-2">{ template.Name }</h1>
				if template.Description.Valid {
					<p class="text-base-content/70 text-lg">{ template.Description.String }</p>
				}
			</div>
			<div class="flex space-x-4">
				<a href="/admin/gauges" 
				   class="btn btn-ghost hover:bg-base-200 active:bg-base-300 transition-all duration-150 active:scale-95"
				   style="min-height: 56px; padding: 0 24px;">
					Back to Gauges
				</a>
				<a href={ templ.SafeURL(fmt.Sprintf("/admin/gauges/%d", template.ID)) } 
				   class="btn btn-primary hover:btn-primary/90 active:btn-primary/95 transition-all duration-150 active:scale-95"
				   style="min-height: 56px; padding: 0 24px;">
					Edit Gauge
				</a>
			</div>
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
			<div class="card bg-base-100 shadow-xl">
				<div class="card-body">
					<div class="flex items-center justify-center py-8">
						<div class="text-center">
							<div class="flex items-center justify-center h-32 w-32 mb-4">
								if gaugeInstance.Value > template.Target {
									<div class="text-error">
										@Icon(template.Icon, "h-24 w-24")
									</div>
								} else {
									<div class="text-primary">
										@Icon(template.Icon, "h-24 w-24")
									</div>
								}
							</div>
							<div class="stats shadow text-center">
								<div class="stat">
									<div class="stat-title">Current Value</div>
									<div class="stat-value">{ fmt.Sprintf("%d", gaugeInstance.Value) }</div>
									<div class="stat-desc">{ template.Unit }</div>
								</div>
								<div class="stat">
									<div class="stat-title">Target</div>
									<div class="stat-value">{ fmt.Sprintf("%d", template.Target) }</div>
									<div class="stat-desc">{ template.Unit }</div>
								</div>
							</div>
							<div class="flex items-center justify-center space-x-4 mt-6">
								<button 
									class="btn btn-primary btn-circle hover:btn-primary/90 active:btn-primary/95 transition-all duration-150 active:scale-95"
									style="min-width: 56px; min-height: 56px; width: 56px; height: 56px;"
									hx-post={ fmt.Sprintf("/gauges/%d/decrement", gaugeInstance.ID) }
									hx-target="#current-value"
									hx-swap="innerHTML"
								>
									<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" /></svg>
								</button>
								<div id="current-value" class="text-4xl font-bold min-w-24 text-center">
									{ fmt.Sprintf("%d %s", gaugeInstance.Value, template.Unit) }
								</div>
								<button 
									class="btn btn-primary btn-circle hover:btn-primary/90 active:btn-primary/95 transition-all duration-150 active:scale-95"
									style="min-width: 56px; min-height: 56px; width: 56px; height: 56px;"
									hx-post={ fmt.Sprintf("/gauges/%d/increment", gaugeInstance.ID) }
									hx-target="#current-value"
									hx-swap="innerHTML"
								>
									<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" /></svg>
								</button>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="card bg-base-100 shadow-xl">
				<div class="card-body">
					<h2 class="card-title mb-4">History</h2>
					<div class="overflow-x-auto">
						<table class="table">
							<thead>
								<tr>
									<th>Date</th>
									<th>Value</th>
									<th>Status</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td>Today</td>
									<td>{ fmt.Sprintf("%d %s", gaugeInstance.Value, template.Unit) }</td>
									<td>
										if gaugeInstance.Value > template.Target {
											<span class="text-error">Above Target</span>
										} else if gaugeInstance.Value < template.Target {
											<span class="text-warning">Below Target</span>
										} else {
											<span class="text-success">On Target</span>
										}
									</td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</div>
}
