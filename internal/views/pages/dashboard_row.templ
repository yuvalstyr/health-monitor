package pages

import (
	"fmt"
	"health-monitor/internal/db"
)

templ DashboardRow(instance db.ListCurrentPeriodGaugeInstancesRow) {
	<tr>
		<td>{ instance.Name }</td>
		<td>{ fmt.Sprintf("%d %s", instance.Value, instance.Unit) }</td>
		<td>{ fmt.Sprintf("%d %s", instance.Target, instance.Unit) }</td>
		<td>
			<span class={ templ.KV("badge badge-success", instance.Value <= instance.Target), templ.KV("badge badge-error", instance.Value > instance.Target) }>
				if instance.Value <= instance.Target {
					On Track
				} else {
					Above Target
				}
			</span>
		</td>
		<td>
			<div class="join">
				<button 
					class="btn btn-sm join-item" 
					hx-post={ fmt.Sprintf("/dashboard/gauges/%d/decrement", instance.ID) }
					hx-target="closest tr"
					hx-swap="outerHTML"
				>-</button>
				<button 
					class="btn btn-sm join-item" 
					hx-post={ fmt.Sprintf("/dashboard/gauges/%d/increment", instance.ID) }
					hx-target="closest tr"
					hx-swap="outerHTML"
				>+</button>
			</div>
		</td>
	</tr>
}
